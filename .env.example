# Base URL for API calls (used in server components)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Google Sheets API Configuration (for FAQ and Menu management)
# Create a service account at https://console.cloud.google.com/
# Download the JSON key file and extract these values:
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SPREADSHEET_FAQ_ID=your_faq_spreadsheet_id_here
GOOGLE_SPREADSHEET_WEEKLY_MENU_ID=your_weekly_menu_spreadsheet_id_here
GOOGLE_SPREADSHEET_CONTACT_ID=your_contact_spreadsheet_id_here

# Google reCAPTCHA v3
# Get your keys from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Webhook Secret (for Google Sheets update webhook)
WEBHOOK_SECRET=your_webhook_secret_here
