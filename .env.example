# Base URL for API calls (used in server components)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# IMPORTANT: Add API restrictions (HTTP referrers) to prevent unauthorized usage
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Google Sheets API Configuration (for FAQ and Menu management)
# Create a service account at https://console.cloud.google.com/
# Download the JSON key file and extract these values:
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Rate Limiting (optional - not currently implemented)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=3600000
